# Copy to `.env` locally. Never commit secrets.

# Backend
DATABASE_URL=postgresql+psycopg://dcf:dcf@postgres:5432/dcf
SESSION_SECRET=change-me-in-production
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false

# Browser calls same-origin /v1 (Next.js rewrites to the API). Leave empty.
NEXT_PUBLIC_API_URL=
API_PROXY_TARGET=http://127.0.0.1:8000

# Growth LLM (narrative explanation of the computed growth path) and Guidance
# LLM (grounded extraction of stated management guidance from pasted source
# text) share one provider account below — any OpenAI-compatible
# /chat/completions endpoint works, including free tiers. Leave
# GROWTH_LLM_API_KEY empty to disable both; the app falls back to the
# statistical/ROIC evidence engine exactly as if it were never configured.
#
# Example using Groq's free-tier OpenAI-compatible endpoint (verify current
# limits/terms yourself at https://console.groq.com before relying on them —
# pricing and rate limits change over time):
# GROWTH_LLM_API_KEY=gsk_your_key_here
# GROWTH_LLM_BASE_URL=https://api.groq.com/openai/v1
# GROWTH_LLM_MODEL=llama-3.3-70b-versatile
GROWTH_LLM_API_KEY=
GROWTH_LLM_BASE_URL=https://api.openai.com/v1
GROWTH_LLM_MODEL=gpt-4o-mini
GROWTH_LLM_TIMEOUT_SECONDS=8
GROWTH_LLM_ENABLED=true
GUIDANCE_LLM_TIMEOUT_SECONDS=15
